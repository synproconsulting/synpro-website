---
/**
 * /services  (SWEB-20, restyled SWEB-26 / 28 / 29)
 *
 * Two practice areas, six offerings. The page groups offerings under their practice so
 * a reader sees two practices rather than one list of six (SWEB-26 criterion 1), and
 * gives the independence disclosure the strongest treatment on the page (criterion 5).
 *
 * NO COPY CHANGED IN SPRINT 6. The offerings became a card grid and the deliverables
 * became structured items; every word is the same. All content stays in the HTML —
 * nothing is hidden behind hover or click (criterion 2).
 *
 * The draft's warning markers and its "Notes for the owner" section are apparatus for
 * the owner and were never transcribed.
 */
import { getCollection, getEntry, render } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';

const page = await getEntry('pages', 'services');
if (!page) throw new Error('Missing content entry: pages/services');
const { title, seoTitle, seoDescription, intro, independence, cta } = page.data;

const practices = (await getCollection('practices')).sort((a, b) => a.data.order - b.data.order);
const offerings = (await getCollection('offerings')).sort((a, b) => a.data.order - b.data.order);

// Render each practice intro and offering description through the Markdown pipeline.
// Done up front because `render()` is async and cannot be awaited inside the template.
const practiceBlocks = await Promise.all(
  practices.map(async (practice) => {
    const { Content: PracticeIntro } = await render(practice);
    const items = await Promise.all(
      offerings
        .filter((offering) => offering.data.practice.id === practice.id)
        .map(async (offering) => ({
          data: offering.data,
          Body: (await render(offering)).Content,
        })),
    );
    return { practice, PracticeIntro, items };
  }),
);

// SWEB-29: in-page anchors only. Every id below belongs to a section on this page.
const markers = [
  ...practiceBlocks.map(({ practice }) => ({
    id: `practice-${practice.id}`,
    label: practice.data.name,
  })),
  ...(independence ? [{ id: 'independence', label: 'Independence' }] : []),
];
---

<PageLayout
  title={title}
  seoTitle={seoTitle}
  seoDescription={seoDescription}
  intro={intro}
  markers={markers}
>
  {
    practiceBlocks.map(({ practice, PracticeIntro, items }) => (
      <section class="practice reveal" aria-labelledby={`practice-${practice.id}`}>
        <p class="eyebrow">Practice area {practice.data.order === 1 ? 'one' : 'two'}</p>
        <h2 class="practice__name" id={`practice-${practice.id}`}>
          {practice.data.name}
        </h2>

        <div class="practice__intro">
          <PracticeIntro />
        </div>

        <div class="offerings">
          {items.map(({ data, Body }) => (
            <article class="offering reveal">
              <p class="offering__number">{String(data.order).padStart(2, '0')}</p>
              <h3 class="offering__title">{data.title}</h3>

              <div class="offering__body prose">
                <Body />
              </div>

              <p class="offering__subhead">What you get</p>
              <ul class="offering__deliverables">
                {data.deliverables.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>

              <p class="offering__whofor">
                <strong>Who it's for</strong> — {data.whoFor}
              </p>

              {data.note && (
                <p class="offering__note">
                  <strong>Note:</strong> {data.note}
                </p>
              )}
            </article>
          ))}
        </div>
      </section>
    ))
  }

  {
    independence && (
      <section class="independence reveal" aria-labelledby="independence-heading" id="independence">
        {/* The mark as texture. Decorative, so alt is empty and it is aria-hidden. */}
        <img
          class="independence__motif"
          src="/mark-spiral.png"
          alt=""
          aria-hidden="true"
          width="192"
          height="95"
        />
        <div class="independence__inner">
          <h2 class="independence__heading" id="independence-heading">
            {independence.heading}
          </h2>
          <div class="independence__body">
            {independence.paragraphs.map((p) => (
              <p>{p}</p>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    cta && (
      <section class="cta reveal">
        {cta.heading && <h2 class="cta__heading">{cta.heading}</h2>}
        <p class="cta__body">{cta.body}</p>
        <p class="cta__label">{cta.label}</p>
      </section>
    )
  }
</PageLayout>
