---
/**
 * Shared page shell for synproconsulting.co.
 *
 * All styling lives in src/styles/ as of SWEB-13. The import order below is the
 * cascade order and matters: tokens define the custom properties, fonts declares
 * the @font-face that references them, global consumes both.
 *
 * These are imported rather than inlined in a <style> block so the token layer is
 * shared by every future route instead of being copied per layout. Astro bundles
 * them into one stylesheet; `build.inlineStylesheets: 'always'` in astro.config.mjs
 * then inlines that into the page (see PROJECT_CONTEXT.md §2).
 *
 * The rules are global, not scoped: they target html, body and the universal
 * selector, which Astro's scoping would rewrite and break.
 */
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /**
   * Class applied to <body> (SWEB-19). global.css styles bare `body` for the
   * placeholder — centred, `overflow: hidden`, full height — which is correct for a
   * one-screen page and wrong for a scrolling one. PageLayout passes "page" here and
   * pages.css overrides those rules at `body.page`, a higher specificity.
   *
   * Left undefined by index.astro, and Astro omits the attribute entirely when a class
   * is undefined — so the placeholder's markup and its CSS bundle are both unchanged.
   */
  bodyClass?: string;
}

const { title, description, bodyClass } = Astro.props;

// Absolute URLs. Open Graph scrapers do not resolve relative paths, so these are
// built against `site` in astro.config.mjs rather than written as "/og-image.png".
const ogImage = new URL('/og-image.png', Astro.site);
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!--
      Icons (SWEB-14). favicon.ico carries 16/32/48/64/128/256 frames. The source
      artwork is a stacked lockup — spiral above "SynPro" above "CONSULTING" — so
      the icon is cropped to the SPIRAL ALONE. Cropping to the full artwork bounds,
      as originally specified, would shrink three stacked elements into 16px and
      produce mush; verified legible at 16 and 32 only after the tighter crop.
    -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!--
      Open Graph. og:image alone does not produce a card - title, type and url are
      required for the major scrapers to render one, so they travel together.
    -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SynPro Consulting" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="SynPro Consulting" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <!--
      Sora is self-hosted (SWEB-13). The Google Fonts <link> and its two
      preconnects were removed: they disclosed every visitor's IP to a third
      party and blocked first render. Preloading the one variable font file
      keeps it off the critical path without a cross-origin round trip.
    -->
    <link
      rel="preload"
      href="/fonts/sora-latin-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
